{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aviram",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Static files in ./public. The Worker only handles /api/* and /media/*.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // Videos + site content live here. Create once: npx wrangler r2 bucket create aviram-media
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "aviram-media" }
  ],
  // aviram.app is a zone in this Cloudflare account; deploys attach it automatically.
  "routes": [
    { "pattern": "aviram.app", "custom_domain": true },
    { "pattern": "www.aviram.app", "custom_domain": true }
  ]
  // Secrets (not in git): npx wrangler secret put ADMIN_PASSWORD
}
